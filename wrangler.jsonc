{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Thin wrapper around the OpenNext worker that adds the cron `scheduled` handler
	// (see worker/custom-worker.ts and src/lib/cron/run.ts).
	"main": "worker/custom-worker.ts",
	"name": "ogadesk",
	"compatibility_date": "2026-11-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "ogadesk.com",
			"custom_domain": true
		},
		{
			// Redirects to the apex in middleware (src/lib/canonical-host.ts)
			"pattern": "www.ogadesk.com",
			"custom_domain": true
		},
		{
			// Legacy address: page visits redirect to ogadesk.com; /api/* keeps
			// working so existing WhatsApp webhooks and API clients don't break.
			"pattern": "ogadesk.dataslid.com.ng",
			"custom_domain": true
		}
	],
	// Non-secret settings (change here and redeploy). Secrets - BREVO_API_KEY,
	// BREVO_WEBHOOK_TOKEN, AUTOMATION_CRON_SECRET - are set with
	// `wrangler secret put` and never live in this file. With no BREVO_API_KEY the
	// CRM/email layer stays a no-op even though the provider is "brevo".
	"vars": {
		"CRM_PROVIDER": "brevo",
		"EMAIL_PROVIDER": "brevo",
		// Must be a sender/domain verified in Brevo.
		"EMAIL_FROM_ADDRESS": "no.reply@ogadesk.com",
		"EMAIL_FROM_NAME": "No Reply",
		// Public domain used in links we hand out (form links, embed snippets, SEO).
		"NEXT_PUBLIC_APP_URL": "https://ogadesk.com"
	},
	"durable_objects": {
		"bindings": [
			{
				// One room per live-chat conversation (worker/chat-room.ts)
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-chat-room",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	// Lets Sentry tag each crash with the deployed Worker version.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"triggers": {
		// Every 5 minutes: CRM outbox flush, automations and flows crons.
		"crons": [
			"*/5 * * * *"
		]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ogadesk"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying:
			//   npx wrangler r2 bucket create ogadesk-opennext-cache
			"bucket_name": "ogadesk-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization (next/image) via Cloudflare Images
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}